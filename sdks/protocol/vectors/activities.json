      "input": {
        "activityId": "act-vector-001",
        "agentId": "agent-vector-1",
        "occurredAt": "2026-01-01T00:00:00.000Z",
        "actionType": "tool-call",
        "action": "pay-vendor",
        "tool": "transfers",
        "policyContext": {
          "policyVersion": "bond-policy-v1",
          "allowedActions": ["pay-vendor"]
        }
      },
      "expected": {
        "activityId": "act-vector-001",
        "agentId": "agent-vector-1",
        "occurredAt": "2026-01-01T00:00:00.000Z",
        "actionType": "tool-call",
        "action": "pay-vendor",
        "tool": "transfers",
        "policyContext": {
          "policyVersion": "bond-policy-v1",
          "allowedActions": ["pay-vendor"]
        }
      }
    },
    {
