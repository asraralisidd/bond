  "invalid": [
    {
      "name": "missing-action",
      "description": "Empty action is rejected client-side.",
      "input": {
        "activityId": "act-vector-bad-1",
        "agentId": "agent-vector-1",
        "occurredAt": "2026-01-01T00:00:00.000Z",
        "actionType": "message",
        "action": "",
        "policyContext": { "policyVersion": "bond-policy-v1" }
      },
      "expectedCode": "INVALID_ACTIVITY_INPUT"
    },
    {
      "name": "unknown-action-type",
      "description": "Action types outside the 7-value whitelist are rejected.",
      "input": {
        "activityId": "act-vector-bad-2",
        "agentId": "agent-vector-1",
        "occurredAt": "2026-01-01T00:00:00.000Z",
        "actionType": "teleport",
        "action": "move",
        "policyContext": { "policyVersion": "bond-policy-v1" }
      },
      "expectedCode": "INVALID_ACTIVITY_INPUT"
    },
    {
      "name": "missing-policy-version",
      "description": "policyContext.policyVersion is required.",
      "input": {
        "activityId": "act-vector-bad-3",
        "agentId": "agent-vector-1",
        "occurredAt": "2026-01-01T00:00:00.000Z",
        "actionType": "message",
        "action": "hi",
        "policyContext": { "policyVersion": "" }
      },
      "expectedCode": "INVALID_ACTIVITY_INPUT"
    },
    {
      "name": "bad-timestamp",
      "description": "Non-ISO occurredAt is rejected.",
      "input": {
        "activityId": "act-vector-bad-4",
        "agentId": "agent-vector-1",
        "occurredAt": "yesterday",
        "actionType": "message",
        "action": "hi",
        "policyContext": { "policyVersion": "bond-policy-v1" }
      },
      "expectedCode": "INVALID_ACTIVITY_INPUT"
    }
  ]
}
