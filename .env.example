# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development

# API
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Web (Vite exposes only VITE_ prefixed vars)
VITE_API_URL=http://localhost:4000

# PostgreSQL (local dev via docker compose; config only — no BOND schema yet)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bond_dev
POSTGRES_USER=bond
POSTGRES_PASSWORD=bond_dev_password_change_me
DATABASE_URL=postgresql://bond:bond_dev_password_change_me@localhost:5432/bond_dev

# Midnight integration (Phase 5; see docs/phase-5/README.md).
# Empty/unset MIDNIGHT_NETWORK selects SIMULATED mode (labeled, local-only).
# Use undeployed for a local devnet, preprod for the public testnet.
# Wallet keys and signing material NEVER go in env files — they arrive via
# injected wallet providers/session objects only.
MIDNIGHT_NETWORK=
# MIDNIGHT_NETWORK=undeployed
MIDNIGHT_INDEXER_HTTP=http://127.0.0.1:8088/api/v4/graphql
MIDNIGHT_INDEXER_WS=ws://127.0.0.1:8088/api/v4/graphql/ws
MIDNIGHT_NODE_URL=http://127.0.0.1:9944
PROOF_SERVER_URL=http://127.0.0.1:6300
BOND_CONTRACT_ADDRESS=
BOND_ZK_ASSETS_PATH=
