# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development

# API
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
# Production: comma-separated explicit allowlist (required, never '*').
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
LOG_LEVEL=info
# Bounded JSON bodies (e.g. 100kb, 256kb, 1mb; max 5mb).
BODY_LIMIT=100kb
# Bounded HTTP responses in ms (0 disables; domain/chain work is unaffected).
REQUEST_TIMEOUT_MS=30000
# Graceful shutdown grace period in ms.
SHUTDOWN_TIMEOUT_MS=10000

# Development authentication (INTERIM — dev only, see docs/phase-7).
# Wallet-signature login is blocked pending the Lace/session shape.
# Never set a real secret here in shared environments.
DEV_AUTH_TOKEN=dev-change-me

# Web (Vite exposes only VITE_ prefixed vars)
VITE_API_URL=http://localhost:4000

# PostgreSQL (local dev via docker compose; config only — no BOND schema yet)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bond_dev
POSTGRES_USER=bond
POSTGRES_PASSWORD=bond_dev_password_change_me
DATABASE_URL=postgresql://bond:bond_dev_password_change_me@localhost:5432/bond_dev
# Pool reliability tuning (validated at startup; all in milliseconds except pool size).
PG_CONNECT_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=30000
PG_POOL_MAX=10
# Idempotency key lifetime in hours (expired keys become reclaimable).
IDEMPOTENCY_TTL_HOURS=24

# Midnight integration (Phase 5; see docs/phase-5/README.md).
# Empty/unset MIDNIGHT_NETWORK selects SIMULATED mode (labeled, local-only).
# Use undeployed for a local devnet, preprod for the public testnet.
# Wallet keys and signing material NEVER go in env files — they arrive via
# injected wallet providers/session objects only.
MIDNIGHT_NETWORK=
# MIDNIGHT_NETWORK=undeployed
MIDNIGHT_INDEXER_HTTP=http://127.0.0.1:8088/api/v4/graphql
MIDNIGHT_INDEXER_WS=ws://127.0.0.1:8088/api/v4/graphql/ws
MIDNIGHT_NODE_URL=http://127.0.0.1:9944
PROOF_SERVER_URL=http://127.0.0.1:6300
BOND_CONTRACT_ADDRESS=
BOND_ZK_ASSETS_PATH=

# Background worker (Phase 9.4; disabled is safe and supported).
WORKER_ENABLED=true
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=5000
WORKER_LEASE_MS=60000
WORKER_MAX_ATTEMPTS=5
WORKER_BACKOFF_BASE_MS=1000
WORKER_BACKOFF_MAX_MS=60000
WORKER_SUBMITTED_RECONCILE_AFTER_MS=300000
WORKER_RECONCILE_INTERVAL_MS=60000
